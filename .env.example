# Optional: Gemini API key for cloud neural TTS (gemini-3.8-flash-lite-tts) and Direct AI Mic STT.
# The app starts and runs 100% offline with local browser voice APIs when unset.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Sarvam AI subscription key for Indian language STT/TTS/Translation (saaras:v4, bulbul:v3, mayura:v1).
# The app starts and runs 100% offline when unset.
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Server port (defaults to 3000).
PORT=3000

# Optional: Public URL where the app is hosted.
APP_URL=http://localhost:3000
